---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale } from '../config';
import siteConfig from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '', noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.es;
const { messages } = getI18n(Astro.url);
type FaqItem = {
  q: string;
  a: string;
};

type FaqCategory = {
  items?: FaqItem[];
};

const faqEntities = (messages.faq?.categories ?? []).flatMap((category: FaqCategory) =>
  (category.items ?? []).map((item: FaqItem) => ({
    '@type': 'Question',
    'name': item.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.a,
    },
  })),
);

const GMAPS_URL = 'https://maps.app.goo.gl/e9zGKMD1ovufKeSS8';
const ogImage = `${siteConfig.baseUrl}/gallery/playa-grande-lican-ray-01.jpg`;

const touristAttractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  'name': messages.header.siteName,
  'description': messages.meta.description,
  'url': canonical,
  'image': ogImage,
  'isAccessibleForFree': true,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Licán Ray',
    'addressRegion': 'La Araucanía',
    'addressCountry': 'CL',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -39.4105,
    'longitude': -72.0831,
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      'opens': '00:00',
      'closes': '23:59',
    },
  ],
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': '4.6',
    'reviewCount': '19192',
  },
  'hasMap': GMAPS_URL,
  'sameAs': [
    GMAPS_URL,
    'https://chile.travel/en/attractions/lican-ray/',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqEntities,
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="es" href={alts.es} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="arn" href={alts.arn} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristAttractionJsonLd)}></script>
    {faqEntities.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
    )}
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
